# AI Studio / Gemini API
GEMINI_API_KEY=

# Cloud SQL / PostgreSQL Connection
DATABASE_URL=
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Auth (better-auth, sessions backed by the Postgres DB above)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL this server is reachable at (used for cookies/redirects)
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated list of extra origins allowed to call the auth API (CORS)
AUTH_TRUSTED_ORIGINS=

# Garage / S3 Object Storage
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_FORCE_PATH_STYLE=
